rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Domain Validators
    function isValidCourseReview(data) {
      return hasOnlyAllowedFields(['courseId', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'createdAt']) &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() < 100 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 100 &&
             (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() < 500)) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    match /course_reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Only authenticated users can create reviews, and they must be the author
      allow create: if isAuthenticated() && 
                    isValidCourseReview(request.resource.data) && 
                    uidUnchanged();
                    
      // Only the author can update their review, and they can't change the author ID or creation date
      allow update: if isDocOwner() && 
                    isValidCourseReview(request.resource.data) && 
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['createdAt', 'userId', 'courseId']);
                    
      // Only the author can delete their review
      allow delete: if isDocOwner();
    }

    // Lista de espera de cursos ainda não lançados.
    // Qualquer visitante pode se cadastrar, mas a lista NUNCA pode ser lida
    // publicamente: são dados pessoais (nome e e-mail) sob a LGPD.
    // A leitura acontece só pelo console do Firebase ou pelo Admin SDK,
    // que ignoram estas regras.
    function isValidWaitlistEntry(data) {
      return hasOnlyAllowedFields(['name', 'email', 'courseId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 200 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() < 100 &&
             data.createdAt is timestamp;
    }

    // Quem pode ler a lista de espera em /admin.
    //
    // Esta lista é a que realmente protege os dados — a de
    // src/config/admin.ts só controla o que a interface mostra. As duas
    // precisam ter os mesmos UID.
    //
    // Para descobrir seu UID: acesse /admin, entre com o Google e a
    // página mostra o identificador na tela.
    function isAdmin() {
      return isAuthenticated() && request.auth.uid in [
        // 'cole-aqui-o-uid-mostrado-na-tela',
      ];
    }

    match /waitlist/{entryId} {
      // Leitura restrita: nome e e-mail são dados pessoais sob a LGPD.
      allow read: if isAdmin();
      allow create: if isValidWaitlistEntry(request.resource.data);
      // Ninguém edita nem apaga pelo site; use o console do Firebase.
      allow update, delete: if false;
    }
  }
}
